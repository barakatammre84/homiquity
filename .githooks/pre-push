#!/usr/bin/env bash
#
# Pre-push gate — the CHEAP half of CI's `gate` job, run locally so the common
# break (a type error, a guard regression) is caught in ~30 s here instead of a
# 4-minute CI round trip. CI runs the whole gate on every PR; this is the early
# warning, not the control.
#
# HOW IT GOT THIS SHAPE — three premises, each of which has since changed:
#
#   1. 2026-08-17: the repo was private and Actions minutes were metered
#      (roadmap KTLO-2; ~13.6 runs/day × 4-5 min ≈ 1,850 of a 2,000-minute
#      allowance), so this hook ran the FULL unit suite too — a red caught here
#      saved two billed runs.
#   2. 2026-08-19: Actions billing failed and every CI run died in ~2 s with no
#      steps. With nothing behind it, this hook became the ONLY gate, so it
#      started BLOCKING pushes from checkouts with no node_modules (PR #608 had
#      gone up from a fresh worktree with zero checks of any kind).
#   3. 2026-08-22: the repo went public, Actions minutes are free, and CI's
#      `gate` job is running again (29 steps, ~3 min). Both special cases are
#      over. What remained was the cost of the suite itself: vitest spawns one
#      worker per core (8 here) and the two lanes take ~1-2 GB and every core
#      for minutes, on every push, docs-only PRs included. On the 8 GB laptop
#      this repo is developed on, with several sessions pushing at once, that
#      is the difference between a usable machine and a swapping one.
#
# WHAT IT RUNS. Typecheck, then the cheap guards — fail-fastest-first, ~30 s all
# in. The unit suite is OPT-IN here and mandatory in CI:
#
#   PREPUSH_TESTS=1 git push      # also run both vitest lanes before pushing
#
# It deliberately does NOT run `pnpm build`, the audit, or the prod health probe;
# those live in `pnpm preflight` / `pnpm checkup`, the heavier pre-PR sweeps.
# This hook is meant to be cheap enough that you leave it on.
#
# INSTALL:  git config core.hooksPath .githooks
# SKIP ONCE: git push --no-verify
#
# The hooks live in a TRACKED directory rather than .git/hooks so they survive a
# reclone and every worktree gets them — .git/hooks is per-clone and invisible to
# review.

set -uo pipefail

# Git pipes one line per ref on stdin. A branch DELETION (`git push origin
# :branch`) has an all-zero local sha and nothing to test, so if every ref on
# this push is a deletion we exit without running anything. Any real ref runs
# the gate. An empty stdin (hook invoked by hand) also runs it.
zero=0000000000000000000000000000000000000000
have_real_ref=0
saw_any_ref=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  saw_any_ref=1
  [ "$local_sha" != "$zero" ] && have_real_ref=1
done
if [ "$saw_any_ref" = 1 ] && [ "$have_real_ref" = 0 ]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# TOOLING PRE-FLIGHT — WARN, never block.
#
# Work happens in a `git worktree`, and a fresh worktree has NO node_modules of its own. An uninstalled checkout is
# a statement about the tooling, not about the code, and a hook that blocks a
# push for a reason the author cannot act on teaches exactly one habit —
# `--no-verify` — which disables the control permanently.
#
# Between 2026-08-19 and 2026-08-22 this BLOCKED instead, and rightly: CI was
# dead, so a skip here was a push with nothing checked at all. CI is back, so a
# skip is a deferral again — the PR's gate still runs every check, including the
# ones this hook never runs. The warning stays loud so it is never a silent pass.
if [ ! -d node_modules ] || ! [ -x node_modules/.bin/tsc ]; then
  echo
  echo "pre-push gate SKIPPED — dependencies are not installed in this checkout"
  echo "  $(pwd)"
  echo
  echo "  A fresh git worktree has no node_modules of its own — expected, not an error."
  echo "  To run the local pre-check here:  pnpm install --frozen-lockfile"
  echo "  CI's gate still runs every check on the PR; this only skips the early warning."
  echo
  exit 0
fi

failed=()

step() {
  local label="$1"; shift
  printf '  %-34s' "$label"
  local start; start=$(date +%s)
  if "$@" >/tmp/prepush-gate.log 2>&1; then
    printf 'ok   (%ss)\n' "$(( $(date +%s) - start ))"
  else
    printf 'FAIL (%ss)\n' "$(( $(date +%s) - start ))"
    failed+=("$label")
    tail -30 /tmp/prepush-gate.log | sed 's/^/      | /'
  fi
}

echo "pre-push gate — the cheap half of CI's \`gate\` job (typecheck + guards)"

# Order is fail-fastest-first: tsc catches the common break (a type error) in
# ~25 s, and the twelve guards cost about a second and a half between them.
step "typecheck (tsc)"          npx tsc --noEmit

# The whole guard suite, added 2026-08-18. Every one of these is a REQUIRED
# check in CI and they cost about a second between them — leaving them out meant
# a design-token regression still burned a CI run to find out.
# Measured on this repo: 9 guards, ~1s total.
step "schema <-> migrations"    node scripts/schema-migration-guard.cjs
step "migration ledger"         node scripts/migration-ledger-guard.cjs
step "delivery-stack freeze"    node scripts/delivery-stack-freeze-guard.cjs
step "design tokens"            node scripts/design-token-guard.cjs
step "UI standard ratchet"      node scripts/ui-standard-guard.cjs
step "knowledge-base index"     node scripts/kb-index-guard.cjs
step "doc staleness ratchet"    node scripts/doc-staleness-guard.cjs
step "query-key convergence"    node scripts/query-key-guard.cjs
# The gate runs all three query-key scripts and the citation ratchet; this hook ran one of
# three and none of the latter, so a push could be locally green and red in CI for a check
# that costs under a second here. Shape alone misses the two that matter most in practice:
# an invalidation that matches no fetch key (reachability) and a queryFn fetching a URL its
# key does not imply (transport).
step "query-key reachability"    node scripts/query-key-reachability.cjs
step "query-key transport"       node scripts/query-key-transport-guard.cjs
step "citation ratchet"          node scripts/citation-guard.cjs
step "selling-guide corpus"      node scripts/selling-guide-corpus-guard.cjs
step "selling-guide coverage"    node scripts/selling-guide-coverage.cjs --check
# --no-freshness: the roster's registry-read date is calendar-driven and would block a push
# for a reason no push caused. The structural half — tables match the roster, definitions
# exist, no doc names an unknown seat — is deterministic and belongs here.
step "routine seat roster"       node scripts/seat-roster-guard.cjs --no-freshness
step "gating reality"            pnpm guard:gating
step "vocabulary registry"       pnpm guard:vocab

# UNIT TESTS — opt-in locally, mandatory in CI. See the header for why: both
# lanes cost ~1-2 GB and every core for minutes, which on a shared 8 GB laptop
# is what makes the machine swap, and CI runs them on every PR regardless.
#
# Note what `pnpm test` now is: scripts/test-collection-guard.cjs, which runs both
# lanes AND checks that vitest actually collected every test file on disk. Three
# times on 2026-08-20/21 it did not — 111 of 118, 214 of 215, 113 of 119 — and
# exited 0 every time, because vitest's file glob discards readdir errors and so
# reads a directory it could not read as an empty one. That failure is a function
# of machine load, which is exactly what is worst on the laptop this hook is
# skipped on; CI's `gate` job is where the floor actually binds.
if [ "${PREPUSH_TESTS:-0}" = "1" ]; then
  step "unit tests (node+client)" pnpm test
else
  printf '  %-34s%s\n' "unit tests (node+client)" "skipped — CI runs them; PREPUSH_TESTS=1 git push runs them here"
fi

if [ ${#failed[@]} -gt 0 ]; then
  echo
  echo "push BLOCKED — ${#failed[@]} check(s) failed: ${failed[*]}"
  echo "full output: /tmp/prepush-gate.log"
  echo "override once with: git push --no-verify"
  exit 1
fi

echo "all green — pushing"
echo
echo "  This hook is the CHEAP half. It does not run the unit suite (CI does, on"
echo "  every PR — or PREPUSH_TESTS=1 here), does not build, does not boot the"
echo "  bundle, and does not run the integration lane — the checks that catch a"
echo "  broken DEPLOY rather than a broken diff. Before opening a PR:"
echo "      pnpm preflight    # the whole gate, ~3 min"
exit 0
